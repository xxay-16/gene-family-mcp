# Backend Django settings
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TRUST_PROXY_SSL_HEADER=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
BACKEND_API_TOKEN=

# SQLite defaults. For PostgreSQL, change DB_ENGINE and fill all fields.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=backend_service/db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_CONN_MAX_AGE=0

# django-q2 ORM queue
Q_CLUSTER_TIMEOUT=300
Q_CLUSTER_RETRY=1890
Q_CLUSTER_MAX_ATTEMPTS=1

# PlantCARE provider
PLANTCARE_EMAIL=
PLANTCARE_AUTH_CODE=
PLANTCARE_IMAP_HOST=imap.qq.com
PLANTCARE_IMAP_PORT=993
PLANTCARE_IMAP_FOLDER=INBOX
PLANTCARE_POLL_INTERVAL=10
PLANTCARE_MAX_POLLS=180
PLANTCARE_RESULT_TIMEOUT=1800
PLANTCARE_POLL_BATCH_SIZE=20
JOB_EXECUTION_LEASE_SECONDS=330
JOB_POLL_LEASE_SECONDS=120
MAX_SEQUENCE_LENGTH=1000000
MAX_ACTIVE_JOBS=1000
MAX_FASTA_INPUT_BYTES=20971520
MAX_FASTA_RECORDS=100000
MAX_FASTA_SEQUENCE_LENGTH=10000000
MAX_FASTA_TOTAL_RESIDUES=50000000
MAX_FASTA_HEADER_LENGTH=1000
DATA_UPLOAD_MAX_MEMORY_SIZE=22020096
MAFFT_EXECUTABLE=mafft
MAFFT_TIMEOUT=1800
MAFFT_DEFAULT_THREADS=2
MAX_TOOL_THREADS=8
MAX_ALIGNMENT_OUTPUT_BYTES=104857600
TOOL_PROBE_TIMEOUT=5
FASTTREE_EXECUTABLE=FastTree
FASTTREE_TIMEOUT=1800
FASTTREE_DEFAULT_THREADS=2
MAX_TREE_OUTPUT_BYTES=20971520
PLANTCARE_ARCHIVE_MAX_MEMBERS=100
PLANTCARE_ARCHIVE_MAX_FILE_SIZE=20971520
PLANTCARE_ARCHIVE_MAX_TOTAL_SIZE=104857600

# Artifact storage
ARTIFACT_ROOT=backend_service/artifacts

# MCP to backend connection
GENE_FAMILY_BACKEND_URL=http://127.0.0.1:8000/api
GENE_FAMILY_BACKEND_TIMEOUT=30
GENE_FAMILY_BACKEND_TOKEN=
